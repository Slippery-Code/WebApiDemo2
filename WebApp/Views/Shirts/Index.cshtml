@*
 auto to index.cshtml anoikei sto shirts controller
 prwto pragma prepei na prosdiorisoume ti model tha xrisimopoisoume
*@

@model List<Shirt> //auto einai epeidh epistrefei mia lista apo to ShirtsController


<h3>Shirts </h3>
<br/>
<table class="table table-striped">
    <thead>
        <tr>
            <td>Brand</td>
            <td>Gender</td>
            <td>Color</td>
            <td>Size</td>
            <td>Price</td>
            <td></td>
            <td></td>
        </tr>
    </thead>
    <tbody>
        @foreach(var shirt in Model)
        {
            <tr>
                <td>@shirt.Brand</td>
                <td>@shirt.Gender</td>
                <td>@shirt.Color</td>
                <td>@shirt.Size</td>
                <td>@(shirt.Price.HasValue?shirt.Price.Value.ToString("c"):"")</td>
                <td><a class="btn btn-link" asp-controller="shirts" asp-action="updateShirt" asp-route-shirtId="@shirt.ShirtId">Edit</a> </td>
                <td>
                    <form method="post" asp-controller="shirts" asp-action="deleteshirt" onsubmit="return confirm('Are you sure you want to delete this shirt?');">
                        <input type="hidden" name="shirtId" value="@shirt.ShirtId" />
                        <button type="submit" class="btn btn-link">Delete</button>
                    </form>
                </td>
            </tr>
        }
    </tbody>
</table>
<br />
<a class="btn btn-primary" asp-controller="shirts" asp-action="createshirt">Create</a> <!-- dimiourgoume ena koumpi gia na pame sto add shirts (to onoma tou controller) -->
<!-- kanoume access to page pliktrologontas to onoma tou controller prin to controller to opoio einai to default routing gia mvc-->


@{
}
